<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/quickadd_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="#0f1729"
  android:padding="14dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/widget_quickadd_label"
    android:textColor="#285ccc"
    android:textSize="10sp"
    android:textStyle="bold"
    android:letterSpacing="0.12" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginTop="10dp">

    <TextView
      android:id="@+id/btn_quickadd_income"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:gravity="center"
      android:text="@string/widget_quickadd_income"
      android:textColor="#ffffff"
      android:textSize="15sp"
      android:textStyle="bold"
      android:background="@drawable/widget_btn_income" />

    <TextView
      android:id="@+id/btn_quickadd_expense"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_marginTop="10dp"
      android:gravity="center"
      android:text="@string/widget_quickadd_expense"
      android:textColor="#ffffff"
      android:textSize="15sp"
      android:textStyle="bold"
      android:background="@drawable/widget_btn_expense" />

  </LinearLayout>

</LinearLayout>
